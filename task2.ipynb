    "word = 'test'\n",
    "word2 = 'testing'\n",
    "\n",
    "for current_word in [word, word2]:\n",
    "    middle = len(current_word) // 2\n",
    "\n",
    "    if len(current_word) % 2 == 0:\n",
    "        print(current_word[middle - 1:middle + 1])\n",
    "    else:\n",
    "        print(current_word[middle])\n"
